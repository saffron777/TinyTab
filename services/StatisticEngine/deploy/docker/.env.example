# Copia este archivo a `.env` en esta misma carpeta y ajusta los valores.
# `docker compose -f deploy/docker/docker-compose.apache.yml ...` lo carga automáticamente.
#
#   Copy-Item .env.example .env
#
# La clave es OBLIGATORIA: el compose falla a propósito si no está definida.

# Clave que deberán enviar los clientes en la cabecera X-Api-Key (larga y aleatoria).
STATISTICENGINE_API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Puerto del host donde Apache publica la API.
APACHE_PORT=8081
