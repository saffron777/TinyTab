{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "StatisticEngine": {
    "Limits": {
      "MaxNumericValues": 100,
      "MaxColumnLength": 100,
      "MaxParameters": 5,
      "MaxDistributionPoints": 50,
      "MaxSampleCount": 1000
    },
    "RateLimit": {
      "Enabled": false
    }
  }
}
