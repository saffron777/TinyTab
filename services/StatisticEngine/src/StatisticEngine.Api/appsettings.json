{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StatisticEngine": {
    "Limits": {
      "MaxNumericValues": 1000000,
      "MaxColumnLength": 250000,
      "MaxTextCharacters": 2000000,
      "MaxParameters": 50,
      "MaxDistributionPoints": 10000,
      "MaxSampleCount": 100000,
      "MaxRequestBodyBytes": 33554432
    },
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Auth": {
      "ApiKey": ""
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Proxy": {
      "Enabled": false
    },
    "RequestTimeoutSeconds": 30
  }
}
